<?xml version="1.0" encoding="utf-8"?>

<component name="DetailsScreen" extends="BaseScreen" initialFocus="moviesList">

    <children>
        <Poster
            id="heroBanner"
            translation="[ 0, 0 ]"
            width="1920"
            height="1080"
            loadWidth="1920"
            loadHeight="1080"
            loadDisplayMode="scaleToZoom"
        />

        <Poster
            id="gradientLayer"
            translation="[ 0, 0 ]"
            loadDisplayMode="scaleToFit"
            uri="pkg:/images/hero-gradient.png"
        />


        <Label
            id="title"
            horizAlign="left"
            vertAlign="center"
            text=""
            visible="true"
            translation="[ 95, 60 ]"> 
            <Font role = "font" uri = "pkg:/fonts/Poppins.ttf" size = "50" />
        </Label>
        <Label
            id="description"
            horizAlign="left"
            vertAlign="top"
            text=""
            visible="true"
            width= "1200"
            translation="[ 95, 140 ]"
            wrap="true"
            numLines = "2"
            lineSpacing="0"
            ellipsizeOnBoundary="true"
            >
        </Label>

        <Button
            id = "morebtn"
            text = "read More" 
            minWidth = "250"
            maxWidth = "250"
            height = "55"
            translation="[1350,140]"
            iconUri = ""
            visible = "false"
            focusedIconUri ="" >

        </Button> 
    </children>

    <interface>
        <field id="selectedContent" type="node"  onChange="onSelectedContent" /> 
    </interface>

    <script type="text/brightscript" uri="pkg:/components/screens/details/DetailsScreen.brs" />
</component>